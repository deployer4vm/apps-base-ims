APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

MIX_APP_ENV=dev

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

DB_CONNECTION_PERTENANT=mysql
DB_HOST_PERTENANT=localhost
DB_PORT_PERTENANT=3306
DB_DATABASE_PERTENANT=homestead
DB_USERNAME_PERTENANT=homestead
DB_PASSWORD_PERTENANT=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

TELESCOPE_ENABLED=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

S3_MULTISERVER_ENABLE=true

S3_MULTISERVER_1_ACCESS_KEY_ID=
S3_MULTISERVER_1_SECRET_ACCESS_KEY=
S3_MULTISERVER_1_DEFAULT_REGION=us-east-1
S3_MULTISERVER_1_BUCKET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

LARAVEL_WEBSOCKETS_HOST=localhost
LARAVEL_WEBSOCKETS_PORT=6001
LARAVEL_WEBSOCKETS_SCHEME=http
LARAVEL_WEBSOCKETS_SSL=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Path to a Firebase service-account JSON file outside the repository, or the
# complete JSON value injected by the deployment secret manager.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
