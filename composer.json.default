{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2.5",
        "beyondcode/laravel-websockets": "^1.4",
        "dompdf/dompdf": "^0.8.3",
        "endroid/qr-code": "^3.7",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",
        "guzzlehttp/guzzle": "^6.3",
        "hp-synapse/mod-user": "dev-master",
        "laravel/framework": "^7.0",
        "laravel/telescope": "^3.5",
        "laravel/tinker": "^2.0",
        "phpoffice/phpspreadsheet": "^1.8",
        "pusher/pusher-php-server": "~4.0"
    },
    "require-dev": {
        "facade/ignition": "^2.0",
        "fzaninotto/faker": "^1.9.1",
        "hp-synapse/apps-generator": "dev-master",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "orangehill/iseed": "^2.6",
        "phpunit/phpunit": "^8.5",
        "reliese/laravel": "^0.0.14"
        //"xethron/migrations-generator": "^2.0"        
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "name": "hp-synapse/apps-generator",
            "type": "path",
            "url": "../apps-generator",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-user",
            "type": "git",
            "url": "https://gitlab.com/hp-synapse/mod-user.git"
        }
    ]
}
