<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>

        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>

        <testsuite name="MainApp Test Suite">
            <directory suffix="Test.php">./app/MainApp/Tests</directory>
        </testsuite>

        <testsuite name="MainApp Modules Test Suite">
            <directory suffix="Test.php">./app/MainApp/Modules/*/Tests</directory>
        </testsuite>

        <testsuite name="MainApp Modules Feature Test Suite">
            <directory suffix="Test.php">./app/MainApp/Modules/*/Tests/Feature</directory>
        </testsuite>

        <testsuite name="MainApp Modules Unit Test Suite">
            <directory suffix="Test.php">./app/MainApp/Modules/*/Tests/Unit</directory>
        </testsuite>
        
        <testsuite name="HP-Synapse Modules Test Suite">
            <directory suffix="Test.php">./vendor/hp-synapse/*/src/Tests</directory>
        </testsuite>

        <testsuite name="HP-Synapse Modules Feature Test Suite">
            <directory suffix="Test.php">./vendor/hp-synapse/*/src/Tests/Feature</directory>
        </testsuite>
        
        <testsuite name="HP-Synapse Modules Unit Test Suite">
            <directory suffix="Test.php">./vendor/hp-synapse/*/src/Tests/Unit</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist processUncoveredFilesFromWhitelist="true">
            <directory suffix=".php">./app</directory>
        </whitelist>
    </filter>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
