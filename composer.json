{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2.5",
        "beberlei/doctrineextensions": "^1.2",
        "beyondcode/laravel-websockets": "^1.4",
        "box/spout": "^3.3",
        "dompdf/dompdf": "^3.1.6",
        "endroid/qr-code": "^3.7",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",
        "guzzlehttp/guzzle": "^7.15.2",
        "hp-synapse/mod-user": "dev-master",
        "hp-synapse/apps-manager": "dev-master",
        "laravel/framework": "^7.30.7",
        "laravel/telescope": "^3.5",
        "laravel/tinker": "^2.0",
        "league/flysystem-aws-s3-v3": "~1.0",
        "league/flysystem-cached-adapter": "~1.0",
        "league/flysystem-sftp": "~1.0",
        "madnest/madzipper": "^1.0",
        "phpoffice/phpspreadsheet": "^1.30.6",
        "pusher/pusher-php-server": "~4.0",
        "ramsey/uuid": "^4.1"
    },
    "require-dev": {
        "facade/ignition": "^2.0",
        "fzaninotto/faker": "^1.9.1",
        "hp-synapse/apps-generator": "dev-master",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "orangehill/iseed": "^2.6",
        "phpunit/phpunit": "^8.5.52",
        "reliese/laravel": "^0.0.14"  
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "name": "hp-synapse/apps-generator",
            "type": "path",
            "url": "../apps-generator",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/apps-manager",
            "type": "path",
            "url": "../apps-manager",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-user",
            "type": "path",
            "url": "../mod-user",
            "options": {
                "symlink": true
            }
        }
    ]
}
